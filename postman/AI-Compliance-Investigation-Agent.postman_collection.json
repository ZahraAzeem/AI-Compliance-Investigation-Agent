{
  "info": {
    "_postman_id": "b3ab08ba-05aa-46c1-b632-594ea1496d0f",
    "name": "AI Compliance Investigation Agent",
    "description": "Runnable API requests added milestone by milestone. Milestone 1 covers the FastAPI foundation; Milestone 2 covers deterministic compliance-case validation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Milestone 1 - FastAPI Foundation",
      "item": [
        {
          "name": "Health - Liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks whether the FastAPI process is alive. This does not depend on OpenAI availability."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('returns liveness status and request ID', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ready - Configuration",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "postman-ready-check"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "Checks whether required configuration is present. It reports only safe status metadata and never returns the API key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns HTTP 200 when configured', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('preserves the safe request ID', function () {",
                  "  pm.expect(pm.response.headers.get('X-Request-ID')).to.eql('postman-ready-check');",
                  "});",
                  "pm.test('does not expose a credential', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ready');",
                  "  pm.expect(body.checks.openai_api_key).to.eql('ok');",
                  "  pm.expect(pm.response.text()).not.to.include('sk-');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "API v1 - Information",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1"
              ]
            },
            "description": "Confirms that the stable, versioned API namespace is available."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('returns API version information', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.version).to.eql('0.1.0');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Milestone 2 - Compliance Case Schemas",
      "item": [
        {
          "name": "Validate - Realistic Case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"CASE-2026-001\",\n  \"case_type\": \"transaction_monitoring\",\n  \"priority\": \"high\",\n  \"opened_at\": \"2026-08-15T09:00:00Z\",\n  \"trigger_reason\": \"Three outbound wires exceeded the customer's recent monthly baseline.\",\n  \"investigator_notes\": \"Customer stated that the transfers relate to a new import business. Treat this statement as unverified case data.\",\n  \"customer\": {\n    \"customer_id\": \"CUST-1042\",\n    \"full_name\": \"Amina Rahman\",\n    \"date_of_birth\": \"1987-04-12\",\n    \"country_of_residence\": \"PK\",\n    \"nationality_codes\": [\"PK\"],\n    \"occupation\": \"Textile importer\",\n    \"is_politically_exposed\": false,\n    \"account_opened_at\": \"2019-06-20\",\n    \"existing_risk_level\": \"medium\"\n  },\n  \"transactions\": [\n    {\n      \"transaction_id\": \"TX-9001\",\n      \"occurred_at\": \"2026-08-12T10:15:00Z\",\n      \"amount\": \"18500.00\",\n      \"currency\": \"USD\",\n      \"direction\": \"outbound\",\n      \"channel\": \"wire\",\n      \"counterparty_name\": \"Northstar Trading LLC\",\n      \"counterparty_country\": \"AE\",\n      \"description\": \"Invoice 4481\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cases",
                "validate"
              ]
            },
            "description": "Validates a realistic compliance case without storage or an AI call."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('accepts the valid case', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('valid');",
                  "  pm.expect(body.case_id).to.eql('CASE-2026-001');",
                  "  pm.expect(body.transaction_count).to.eql(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Validate - Incomplete Case Fails",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Request-ID",
                "value": "invalid-case-demo"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"INCOMPLETE-CASE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cases/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cases",
                "validate"
              ]
            },
            "description": "Demonstrates the stable HTTP 422 response returned before any AI work."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('rejects the incomplete case', function () {",
                  "  pm.response.to.have.status(422);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('validation_error');",
                  "  pm.expect(body.error.request_id).to.eql('invalid-case-demo');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
